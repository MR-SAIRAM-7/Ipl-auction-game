# Only needed when the client is hosted SEPARATELY from the server
# (for example the client on Vercel and the server on Render).
#
# Leave it unset for the normal single-origin deploy, where the Node server serves
# this client itself - the app then talks to its own origin.
#
# Set it to the full origin of the API server, with no trailing slash:
VITE_API_URL=https://your-server.onrender.com
