# Copy to server/.env for local development.
# Every value here is optional - the app boots and plays without any of it.

# ---- runtime ----
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Comma-separated origins the browser loads the app from.
CLIENT_ORIGIN=http://localhost:5173

# Private LAN origins are allowed automatically in development so phones can join.
# Set to "true" to keep that in production (only do this on a trusted network).
ALLOW_LAN_ORIGINS=

# Number of proxy hops in front of the app, so rate limiting sees the real client IP.
TRUST_PROXY_HOPS=1

# ---- optional services ----
# MongoDB. Without it, rooms live in memory for the session.
MONGODB_URI=

# Gemini. Without it, players and the verdict come from the built-in generators.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_COMMENTARY=true

# TURN relay. REQUIRED for voice to work on mobile data: carrier NAT gives two
# phones no direct path to each other, and only a relay can bridge them. Voice on
# home wifi works without this; bidding and chat never need it.
#
# Pick ONE of the two blocks below.

# (a) Cloudflare Realtime - the largest free allowance, and what we recommend.
# Create a TURN key at dash.cloudflare.com -> Realtime -> TURN, then paste the key
# ID and its API token. Credentials are short-lived, so the server mints them.
TURN_KEY_ID=
TURN_KEY_API_TOKEN=

# (b) Any static relay - self-hosted coturn, Metered, Xirsys. All three are needed:
# with a URL but no credentials the relay is ignored and you are back to STUN only.
# List a udp, a tcp and a turns:443 entry so restrictive networks have a way through.
TURN_URLS=turn:relay.example.com:3478?transport=udp,turn:relay.example.com:3478?transport=tcp,turns:relay.example.com:443?transport=tcp
TURN_USERNAME=
TURN_CREDENTIAL=

# ---- capacity (defaults are fine) ----
MAX_ROOMS=500
MAX_TEAMS_PER_ROOM=12
MAX_MEMBERS_PER_TEAM=8
